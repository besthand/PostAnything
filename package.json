{
  "name": "agent-http-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/adapters/node/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/adapters/node/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "dev:workers": "wrangler dev",
    "deploy:workers": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.125.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.5"
  }
}
