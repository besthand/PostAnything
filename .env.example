# ==============================
# Authentication
# ==============================
# 產生方式：node -e "console.log('relay_'+require('crypto').randomBytes(32).toString('base64url'))"
RELAY_TOKEN=replace_with_256_bit_random_secret

# ==============================
# HTTP Access Control
# ==============================
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
ALLOWED_HOSTS=flow.handbro.pro,talkai.soft4fun.tw
ALLOW_ANY_PUBLIC_HOST=false
ALLOW_HTTP=false

# ==============================
# HTTP Limits
# ==============================
MAX_REQUEST_BODY_BYTES=2097152
MAX_RESPONSE_BODY_BYTES=5242880
REQUEST_TIMEOUT_MS=30000
FOLLOW_REDIRECTS=false

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ==============================
# Server
# ==============================
PORT=3000
NODE_ENV=production

# ==============================
# Cloudflare Workers 專用
# ==============================
DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
